# Copia a .env y ajusta. docker compose lo lee solo.

# Modelo dentro de ./models (descárgalo con ./scripts/download-model.sh)
VOZGO_MODEL_NAME=ggml-base.bin

# Idioma ISO o auto
VOZGO_LANGUAGE=es

# Formatos de salida: txt,srt,vtt,json,md
VOZGO_FORMATS=txt

# Vocabulario propio para sesgar el decodificado: nombres, siglas y jerga que
# whisper no acierta solo. Baja el error notablemente en audios cortos.
VOZGO_PROMPT="Adipa, Keycloak, Moodle, Dataverse, CRM, junta médica, medicina laboral, medicina ocupacional, ortopedia, PDF"

# Retención del historial en `serve` (0 = sin límite)
VOZGO_MAX_JOBS=200
VOZGO_JOB_TTL=24h

# Concurrencia. Déjalos vacíos para que vozgo los calcule según CPU y RAM.
# Ojo: workers x threads no debe pasar el nº de CPUs lógicas.
VOZGO_WORKERS=
VOZGO_THREADS=

# Puerto del host para la UI
VOZGO_PORT=8080

# Compute capability de tu GPU para el target cuda (75 = GTX 16xx / RTX 20xx)
CUDA_ARCH=75
