# Copia a .env y ajusta. docker compose lo lee solo.

# Modelo dentro de ./models (se descarga solo en el primer arranque).
# ggml-large-v3-turbo.bin es el mejor: 1,2 % de error y ~5x tiempo real, pero
# necesita ~3,4 GB para el contenedor. Con menos memoria, usa ggml-small.bin.
VOZGO_MODEL_NAME=ggml-large-v3-turbo.bin

# Idioma ISO o auto
VOZGO_LANGUAGE=es

# Formatos de salida: txt,srt,vtt,json,md
VOZGO_FORMATS=txt

# Prompt inicial: sesga el decodificado hacia un dialecto y un vocabulario.
# Por defecto se usa español colombiano (prompts/es-CO.txt), que en las notas
# medidas baja el WER de 9,6 % a 4,8 %. Déjalo vacío para desactivarlo.
VOZGO_PROMPT_FILE=/prompts/es-CO.txt

# VOZGO_PROMPT gana sobre el archivo, para un ajuste puntual sin editarlo.
VOZGO_PROMPT=

# Retención del historial en `serve` (0 = sin límite)
VOZGO_MAX_JOBS=200
VOZGO_JOB_TTL=24h

# Concurrencia. Déjalos vacíos para que vozgo los calcule según CPU y RAM.
# Ojo: workers x threads no debe pasar el nº de CPUs lógicas.
VOZGO_WORKERS=
VOZGO_THREADS=

# Puerto del host para la UI
VOZGO_PORT=8080

# Compute capability de tu GPU para el target cuda (75 = GTX 16xx / RTX 20xx)
CUDA_ARCH=75
